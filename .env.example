# Database - Development (MySQL)
DB_HOST_DEV=localhost
DB_USER_DEV=root
DB_PASS_DEV=
DB_NAME_DEV=
DB_PORT_DEV=3306

# Database - Production (MySQL)
DB_HOST_PROD=localhost
DB_USER_PROD=root
DB_PASS_PROD=
DB_NAME_PROD=
DB_PORT_PROD=3306

# SMTP
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Encryption Key (generated 32-char random)
ENCRYPTION_KEY=

# Base URL (overrides auto-detection)
BASE_URL=

# Timezone
TIMEZONE=Asia/Jakarta

# Index Page (empty for clean URLs)
INDEX_PAGE=

# Session
SESSION_COOKIE_NAME=ci3_boiler_admin
SESSION_EXPIRATION=259200
SESSION_TIME_TO_UPDATE=300
SESSION_SAVE_PATH=

# CSRF
CSRF_PROTECTION=true
CSRF_TOKEN_NAME=csrf_test_name
CSRF_COOKIE_NAME=csrf_cookie_name
CSRF_EXPIRE=7200

# Logging (0=Off, 1=Errors, 2=Debug, 3=Info, 4=All)
LOG_THRESHOLD=0

# Email From
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=

# Firebase Service Account (relative path inside env/ or absolute path outside webroot)
FCM_SERVICE_ACCOUNT_FILE=

# Firebase VAPID Key (for web push)
FCM_VAPID_KEY=

# Navigation Layout: sidebar | topnav
NAV_LAYOUT=sidebar