# Database - Development
DB_HOST_DEV=localhost
DB_USER_DEV=postgres
DB_PASS_DEV=
DB_NAME_DEV=itg_qrtag
DB_PORT_DEV=5434

# Database - Production
DB_HOST_PROD=localhost
DB_USER_PROD=postgres
DB_PASS_PROD=
DB_NAME_PROD=itg_qrtag
DB_PORT_PROD=5432

# SMTP
SMTP_HOST=smtp.internalgroup.id
SMTP_PORT=587
SMTP_USER=noreply@internalgroup.id
SMTP_PASS=

# Encryption Key (generate 32-char random, e.g. via: php -r "echo bin2hex(random_bytes(16));")
ENCRYPTION_KEY=

# Base URL — override auto-detection (kosongkan untuk auto-detect based on HTTP_HOST)
BASE_URL=

# Session
SESSION_COOKIE_NAME=itg_qrtag_session

# Email From
EMAIL_FROM_ADDRESS=no-reply@internalgroup.id
EMAIL_FROM_NAME=Hoki Beli Illusions

# Firebase Service Account JSON file path
# Default: env/firebase-service-account.json (already gitignored)
# Production: bisa diarahkan ke /etc/itg-gift/firebase-service-account.json
FCM_SERVICE_ACCOUNT_FILE=

# Firebase VAPID Key (dapatkan dari Firebase Console → Cloud Messaging → Web Push)
FCM_VAPID_KEY=
